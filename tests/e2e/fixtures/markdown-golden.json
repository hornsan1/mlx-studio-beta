{
  "version": 1,
  "dialect": "gfm-profile",
  "parser": "lightweight-gfm-lite",
  "description": "Single source-of-truth Markdown golden corpus for parser/AST tests. Expand as Milestone 1 covers full GFM.",
  "cases": [
    {
      "id": "basic-bold-code-table",
      "source": "**Markdown works.**\n\n| Check | Result |\n| --- | --- |\n| Table | PASS |\n\n```swift\nprint(\"MARKDOWN_E2E\")\n```",
      "expect": {
        "blockKinds": [
          "prose",
          "table",
          "code"
        ],
        "table": {
          "headers": [
            "Check",
            "Result"
          ],
          "alignments": [
            "leading",
            "leading"
          ],
          "rows": [
            [
              "Table",
              "PASS"
            ]
          ]
        },
        "code": {
          "language": "swift",
          "body": "print(\"MARKDOWN_E2E\")\n",
          "isClosed": true
        }
      }
    },
    {
      "id": "table-alignment-escaped-pipes",
      "source": "| Expression | Value | Notes |\n| :--- | :---: | ---: |\n| `a|b` | x \\| y | right |",
      "expect": {
        "blockKinds": [
          "table"
        ],
        "table": {
          "headers": [
            "Expression",
            "Value",
            "Notes"
          ],
          "alignments": [
            "leading",
            "center",
            "trailing"
          ],
          "rows": [
            [
              "`a|b`",
              "x | y",
              "right"
            ]
          ]
        }
      }
    },
    {
      "id": "pipe-prose-without-delimiter",
      "source": "This | remains ordinary prose.\nIt has no GFM delimiter row.",
      "expect": {
        "blockKinds": [
          "prose"
        ]
      }
    },
    {
      "id": "unclosed-fence-is-code",
      "source": "Intro\n\n```python\nprint(1)\n",
      "expect": {
        "blockKinds": [
          "prose",
          "code"
        ],
        "code": {
          "language": "python",
          "body": "print(1)\n",
          "isClosed": false
        }
      }
    },
    {
      "id": "raw-html-inert-as-prose",
      "source": "Before\n\n<script>alert(1)</script>\n\nAfter",
      "expect": {
        "blockKinds": [
          "prose"
        ],
        "containsLiteral": "<script>alert(1)</script>"
      }
    },
    {
      "id": "nested-code-then-table",
      "source": "```\nplain\n```\n\n| A | B |\n| --- | --- |\n| 1 | 2 |",
      "expect": {
        "blockKinds": [
          "code",
          "table"
        ],
        "code": {
          "language": "",
          "body": "plain\n",
          "isClosed": true
        },
        "table": {
          "headers": [
            "A",
            "B"
          ],
          "alignments": [
            "leading",
            "leading"
          ],
          "rows": [
            [
              "1",
              "2"
            ]
          ]
        }
      }
    },
    {
      "id": "tilde-fence",
      "source": "~~~\nhello\n~~~",
      "expect": {
        "blockKinds": [
          "code"
        ],
        "code": {
          "language": "",
          "body": "hello\n",
          "isClosed": true
        }
      }
    },
    {
      "id": "list-2space-nested",
      "source": "- parent\n  - child",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "parent"
          },
          {
            "ordered": false,
            "indentLevel": 1,
            "text": "child"
          }
        ]
      }
    },
    {
      "id": "list-mixed-tight",
      "source": "- alpha\n- beta\n- gamma",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "alpha"
          },
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "beta"
          },
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "gamma"
          }
        ]
      }
    },
    {
      "id": "task-list-basic",
      "source": "- [ ] todo\n- [x] done\n- [X] also done",
      "expect": {
        "blockKinds": [
          "taskItem",
          "taskItem",
          "taskItem"
        ],
        "taskItems": [
          {
            "checked": false,
            "indentLevel": 0,
            "text": "todo"
          },
          {
            "checked": true,
            "indentLevel": 0,
            "text": "done"
          },
          {
            "checked": true,
            "indentLevel": 0,
            "text": "also done"
          }
        ]
      }
    },
    {
      "id": "heading-atx-levels",
      "source": "# One\n## Two\n### Three",
      "expect": {
        "blockKinds": [
          "heading",
          "heading",
          "heading"
        ],
        "headings": [
          {
            "level": 1,
            "text": "One"
          },
          {
            "level": 2,
            "text": "Two"
          },
          {
            "level": 3,
            "text": "Three"
          }
        ]
      }
    },
    {
      "id": "blockquote-simple",
      "source": "> first\n> second",
      "expect": {
        "blockKinds": [
          "blockquote"
        ],
        "blockquote": {
          "quoteDepth": 1,
          "text": "first\nsecond"
        }
      }
    },
    {
      "id": "thematic-break-hr",
      "source": "Before\n\n---\n\nAfter",
      "expect": {
        "blockKinds": [
          "prose",
          "thematicBreak",
          "prose"
        ]
      }
    },
    {
      "id": "list-over-indent-clamp",
      "source": "- L0\n  - L1\n    - L2\n      - L3\n        - L4\n          - L5\n            - L6\n              - L7",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem",
          "listItem",
          "listItem",
          "listItem",
          "listItem",
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "L0"
          },
          {
            "ordered": false,
            "indentLevel": 1,
            "text": "L1"
          },
          {
            "ordered": false,
            "indentLevel": 2,
            "text": "L2"
          },
          {
            "ordered": false,
            "indentLevel": 3,
            "text": "L3"
          },
          {
            "ordered": false,
            "indentLevel": 4,
            "text": "L4"
          },
          {
            "ordered": false,
            "indentLevel": 5,
            "text": "L5"
          },
          {
            "ordered": false,
            "indentLevel": 5,
            "text": "L6"
          },
          {
            "ordered": false,
            "indentLevel": 5,
            "text": "L7"
          }
        ]
      }
    },
    {
      "id": "sloppy-list-tab-indent",
      "source": "- parent\n\t- child",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "parent"
          },
          {
            "ordered": false,
            "indentLevel": 1,
            "text": "child"
          }
        ]
      }
    },
    {
      "id": "list-ordered-start-at-3",
      "source": "3. first\n4. second",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": true,
            "index": 3,
            "indentLevel": 0,
            "text": "first"
          },
          {
            "ordered": true,
            "index": 4,
            "indentLevel": 0,
            "text": "second"
          }
        ]
      }
    },
    {
      "id": "list-ordered-nested-continue",
      "source": "1. parent a\n   1. nested\n2. parent b",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 0,
            "text": "parent a"
          },
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 1,
            "text": "nested"
          },
          {
            "ordered": true,
            "index": 2,
            "indentLevel": 0,
            "text": "parent b"
          }
        ]
      }
    },
    {
      "id": "list-ordered-restart-after-prose",
      "source": "1. first list\n\nInterrupting paragraph.\n\n1. new list",
      "expect": {
        "blockKinds": [
          "listItem",
          "prose",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 0,
            "text": "first list"
          },
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 0,
            "text": "new list"
          }
        ]
      }
    },
    {
      "id": "list-ordered-loose-continue",
      "source": "1. a\n\n2. b",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 0,
            "text": "a"
          },
          {
            "ordered": true,
            "index": 2,
            "indentLevel": 0,
            "text": "b"
          }
        ]
      }
    },
    {
      "id": "list-ordered-paren-marker",
      "source": "1) a\n2) b",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 0,
            "text": "a"
          },
          {
            "ordered": true,
            "index": 2,
            "indentLevel": 0,
            "text": "b"
          }
        ]
      }
    },
    {
      "id": "task-list-star-marker",
      "source": "* [ ] todo\n* [x] done",
      "expect": {
        "blockKinds": [
          "taskItem",
          "taskItem"
        ],
        "taskItems": [
          {
            "checked": false,
            "indentLevel": 0,
            "text": "todo"
          },
          {
            "checked": true,
            "indentLevel": 0,
            "text": "done"
          }
        ]
      }
    },
    {
      "id": "no-whitespace-only-prose-after-heading",
      "source": "# H\n",
      "expect": {
        "blockKinds": [
          "heading"
        ],
        "headings": [
          {
            "level": 1,
            "text": "H"
          }
        ]
      }
    },
    {
      "id": "no-whitespace-only-prose-between-headings",
      "source": "# A\n\n# B",
      "expect": {
        "blockKinds": [
          "heading",
          "heading"
        ],
        "headings": [
          {
            "level": 1,
            "text": "A"
          },
          {
            "level": 1,
            "text": "B"
          }
        ]
      }
    },
    {
      "id": "no-whitespace-only-prose-trailing-list",
      "source": "- a\n- b\n",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "a"
          },
          {
            "ordered": false,
            "indentLevel": 0,
            "text": "b"
          }
        ]
      }
    },
    {
      "id": "list-ordered-start-at-0",
      "source": "0. zero\n1. one",
      "expect": {
        "blockKinds": [
          "listItem",
          "listItem"
        ],
        "listItems": [
          {
            "ordered": true,
            "index": 0,
            "indentLevel": 0,
            "text": "zero"
          },
          {
            "ordered": true,
            "index": 1,
            "indentLevel": 0,
            "text": "one"
          }
        ]
      }
    }
  ],
  "linkPolicy": {
    "allowedSchemes": [
      "https",
      "http",
      "mailto"
    ],
    "blockedExamples": [
      "file:///etc/passwd",
      "javascript:alert(1)",
      "vmlx://local",
      "data:text/html,hi"
    ],
    "allowedExamples": [
      "https://example.com/path",
      "http://localhost:8080",
      "mailto:user@example.com"
    ]
  }
}